{
  "name": "near-arbitrage-bot",
  "version": "2.0.0",
  "description": "High-speed arbitrage bot for NEAR Intents API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "clean": "rm -rf dist logs storage",
    "executor": "ts-node src/run-executor.ts",
    "executor:dry": "DRY_RUN_ONLY=true ts-node src/run-executor.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "axios": "^1.16.0",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
